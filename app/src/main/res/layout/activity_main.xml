<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mc_bg">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/rootContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="26dp"
        android:paddingBottom="30dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenDrawer"
            style="@style/Widget.MailCrusher.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☰  MENU"
            android:contentDescription="Open authorized recipients" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MAILCRUSHER"
            android:textColor="@color/mc_text"
            android:fontFamily="@font/montserrat_variable"
            android:fontWeight="800"
            android:letterSpacing="-0.025"
            android:textSize="32sp"
            android:paddingBottom="28dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Connect Gmail account" />

        <TextView
            android:id="@+id/txtAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No Gmail account selected. Tap Connect Gmail account."
            android:textColor="@color/mc_text"
            android:fontFamily="@font/montserrat_variable"
                android:fontWeight="600"
            android:background="@drawable/bg_surface"
            android:padding="18dp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CREATE YOUR BATCH"
            android:textColor="@color/mc_muted"
            android:fontFamily="@font/montserrat_variable"
            android:fontWeight="800"
            android:letterSpacing="0.08"
            android:textSize="11sp"
            android:paddingBottom="10dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Recipient email (add it in the menu first)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtRecipient"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                android:textColor="@color/mc_text"
                android:fontFamily="@font/montserrat_variable"
                android:fontWeight="600" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Your email subject (max 120 characters)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtSubject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLength="120"
                android:textColor="@color/mc_text"
                android:fontFamily="@font/montserrat_variable"
                android:fontWeight="600" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Your message body">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="4"
                android:maxLines="8"
                android:gravity="top|start"
                android:textColor="@color/mc_text"
                android:fontFamily="@font/montserrat_variable"
                android:fontWeight="600" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SEND INTERVAL"
            android:textColor="@color/mc_muted"
            android:fontFamily="@font/montserrat_variable"
            android:fontWeight="800"
            android:textSize="11sp"
            android:paddingTop="18dp" />

        <TextView
            android:id="@+id/txtIntervalValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3 seconds"
            android:textColor="@color/mc_text"
            android:fontFamily="@font/montserrat_variable"
            android:fontWeight="700"
            android:paddingTop="4dp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderInterval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0.1"
            android:valueTo="60"
            android:stepSize="0.1"
            android:value="3"
            app:labelBehavior="withinBounds" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Number of messages (1–1000)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtMessageCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:text="1"
                android:textColor="@color/mc_text"
                android:fontFamily="@font/montserrat_variable"
                android:fontWeight="600" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGenerate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Generate messages"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GENERATED MESSAGES"
            android:textColor="@color/mc_muted"
            android:fontFamily="@font/montserrat_variable"
            android:fontWeight="800"
            android:letterSpacing="0.08"
            android:textSize="11sp"
            android:paddingTop="22dp"
            android:paddingBottom="10dp" />

        <TextView
            android:id="@+id/txtPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_surface"
            android:textColor="@color/mc_text"
            android:fontFamily="@font/montserrat_variable"
                android:fontWeight="600"
            android:padding="17dp"
            android:text="Your generated messages will appear here." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Send all generated messages"
            android:layout_marginTop="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCheckStatus"
            style="@style/Widget.MailCrusher.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Check send status" />

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/mc_text"
            android:fontFamily="@font/montserrat_variable"
                android:fontWeight="600"
            android:background="@drawable/bg_surface"
            android:padding="16dp"
            android:layout_marginTop="12dp"
            android:text="Status: ready" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHistory"
            style="@style/Widget.MailCrusher.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View sent history"
            android:layout_marginTop="14dp" />
    </LinearLayout>
</ScrollView>

    <LinearLayout
        android:id="@+id/authorizedDrawer"
        android:layout_width="310dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@color/mc_bg"
        android:elevation="18dp"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AUTHORIZED RECIPIENTS"
            android:textColor="@color/mc_text"
            android:textSize="19sp"
            android:fontFamily="@font/montserrat_variable"
            android:fontWeight="800"
            android:paddingTop="28dp"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add only addresses whose owners agreed to receive your test emails. Remove access any time."
            android:textColor="@color/mc_muted"
            android:textSize="12sp"
            android:paddingBottom="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddRecipient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="+ Add authorized address" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/authorizedList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="12dp" />
        </ScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseDrawer"
            style="@style/Widget.MailCrusher.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Close menu" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
