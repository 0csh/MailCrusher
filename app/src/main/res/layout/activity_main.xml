<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mc_bg"
    android:fillViewport="true">
    <LinearLayout
        android:id="@+id/rootContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="32dp"
        android:paddingBottom="30dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MailCrusher V1"
            android:textColor="@color/mc_text"
            android:fontFamily="@font/montserrat_variable"
            android:fontWeight="800"
            android:letterSpacing="-0.025"
            android:textSize="30sp"
            android:paddingBottom="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Connect Gmail account" />

        <TextView
            android:id="@+id/txtAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No Gmail account selected. Tap Connect Gmail account."
            android:textColor="@color/mc_text"
            android:fontFamily="@font/montserrat_variable"
                android:fontWeight="600"
            android:background="@drawable/bg_surface"
            android:padding="17dp"
            android:layout_marginBottom="22dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MESSAGE SETTINGS"
            android:textColor="@color/mc_muted"
            android:fontFamily="@font/montserrat_variable"
            android:fontWeight="800"
            android:letterSpacing="0.08"
            android:textSize="11sp"
            android:paddingBottom="10dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Recipient email (your authorized address)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtRecipient"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                android:textColor="@color/mc_text"
                android:fontFamily="@font/montserrat_variable"
                android:fontWeight="600" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Subject length (1–120)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtSubjectLength"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:text="16"
                android:textColor="@color/mc_text"
                android:fontFamily="@font/montserrat_variable"
                android:fontWeight="600" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Message body length (1–1000)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtBodyLength"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:text="80"
                android:textColor="@color/mc_text"
                android:fontFamily="@font/montserrat_variable"
                android:fontWeight="600" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Number of drafts to generate (1–5)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtMessageCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:text="1"
                android:textColor="@color/mc_text"
                android:fontFamily="@font/montserrat_variable"
                android:fontWeight="600" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGenerate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Generate drafts"
            android:layout_marginTop="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PREVIEW"
            android:textColor="@color/mc_muted"
            android:fontFamily="@font/montserrat_variable"
            android:fontWeight="800"
            android:letterSpacing="0.08"
            android:textSize="11sp"
            android:paddingTop="22dp"
            android:paddingBottom="10dp" />

        <TextView
            android:id="@+id/txtPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_surface"
            android:textColor="@color/mc_text"
            android:fontFamily="@font/montserrat_variable"
                android:fontWeight="600"
            android:padding="17dp"
            android:text="Your generated drafts will appear here." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Review and send one"
            android:layout_marginTop="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCheckStatus"
            style="@style/Widget.MailCrusher.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Check send status" />

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/mc_text"
            android:fontFamily="@font/montserrat_variable"
                android:fontWeight="600"
            android:background="@drawable/bg_surface"
            android:padding="15dp"
            android:layout_marginTop="12dp"
            android:text="Status: ready" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHistory"
            style="@style/Widget.MailCrusher.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View sent history"
            android:layout_marginTop="14dp" />
    </LinearLayout>
</ScrollView>