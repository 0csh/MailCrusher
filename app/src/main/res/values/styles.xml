<resources>
    <style name="Theme.MailCrusher" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">#A78BFA</item>
        <item name="colorPrimaryVariant">#7C5CC4</item>
        <item name="colorOnPrimary">#0B0D10</item>
        <item name="colorSecondary">#A78BFA</item>
        <item name="colorOnSecondary">#0B0D10</item>
        <item name="android:colorAccent">#A78BFA</item>
        <item name="android:statusBarColor">#0B0D10</item>
        <item name="android:navigationBarColor">#0B0D10</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">#0B0D10</item>
        <item name="materialButtonStyle">@style/Widget.MailCrusher.Button</item>
        <item name="textInputStyle">@style/Widget.MailCrusher.TextInputLayout</item>
    </style>

    <style name="Widget.MailCrusher.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">18dp</item>
        <item name="strokeColor">@color/mc_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="backgroundTint">@color/mc_button</item>
        <item name="android:textColor">@color/mc_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/montserrat_variable</item>
        <item name="android:fontWeight">600</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:insetTop">3dp</item>
        <item name="android:insetBottom">3dp</item>
    </style>

    <style name="Widget.MailCrusher.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/mc_outline</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1dp</item>
        <item name="boxBackgroundColor">@color/mc_surface</item>
        <item name="hintTextColor">@color/mc_muted</item>
    </style>

    <style name="Widget.MailCrusher.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">18dp</item>
        <item name="strokeColor">@color/mc_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/mc_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">50dp</item>
    </style>
</resources>